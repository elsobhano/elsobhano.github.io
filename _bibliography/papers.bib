@inproceedings{asasi2026signseek,
  google_scholar_id={IjCSPb-OGe4C},
  preview={signseek.png},
  abbr={WACV},
  bibtex_show={true},
  title={SignSeek: Learning Transferable Representations for Sign Dictionary Retrieval},
  author={Asasi, Sobhan and Sincan, Ozge Mercanoglu and Bowden, Richard},
  abstract={Automated sign language dictionary retrieval aims to find a sign in a dictionary given a query video, a task made difficult by the wide variability across signers. SignSeek employs contrastive learning with Articulator Saliency-Guided Masking (ASGM), which identifies the most critical articulator for each sign, and combines masked contrastive alignment with masked prediction losses. Trained on approximately 266,000 samples across multiple sign languages, the method achieves state-of-the-art performance on cross-corpus retrieval benchmarks (ASL-Citizen, WLASL, NMFs-CSL) without fine-tuning, and demonstrates zero-shot generalisation to unseen British Sign Language.},
  booktitle={IEEE/CVF Winter Conference on Applications of Computer Vision (WACV 2027)},
  year={2026},
  month={September},
  arxiv={2609.03695},
  selected={true}
}

@inproceedings{asasi2026signet,
  google_scholar_id={UeHWp8X0CEIC},
  preview={signet.png},
  abbr={ECCV},
  bibtex_show={true},
  title={SIGNET: Motion-Level Knowledge Transfer for Cross-Language Sign Language Translation},
  author={Asasi, Sobhan and Sincan, Ozge Mercanoglu and Bowden, Richard},
  abstract={Pretrained sign language models capture visual patterns that are reusable across datasets and languages. SIGNET integrates multiple pretrained sign language models through an attention-based, hand-prior aggregation mechanism combined with a gated fusion network, enabling motion-level knowledge transfer for cross-language sign language translation. Experiments on four benchmarks (How2Sign, Phoenix14T, CSL-Daily and MeineDGS) demonstrate state-of-the-art results, with additional gains on WLASL for sign language recognition.},
  booktitle={European Conference on Computer Vision (ECCV)},
  year={2026},
  month={June},
  arxiv={2606.28626},
  website={https://cogvis-cvssp.github.io/papers/signet},
  selected={true}
}

@article{sincan2025glossfree,
  google_scholar_id={2osOgNQ5qMEC},
  preview={sltbaselines.png},
  abbr={CVIU},
  bibtex_show={true},
  title={Gloss-free sign language translation: An unbiased evaluation of progress in the field},
  author={Sincan, Ozge Mercanoglu and Low, Jian He and Asasi, Sobhan and Bowden, Richard},
  abstract={Sign Language Translation (SLT) systems convert sign language videos into spoken language text. We re-implement recent SLT models and evaluate them under standardised, consistent conditions. We find that many of the performance gains reported in the literature often diminish when models are evaluated under consistent conditions, offering an unbiased view of progress in the field.},
  journal={Computer Vision and Image Understanding (CVIU)},
  volume={261},
  pages={104498},
  year={2025},
  publisher={Elsevier},
  doi={10.1016/j.cviu.2025.104498},
  html={https://doi.org/10.1016/j.cviu.2025.104498},
  arxiv={2603.13240},
  code={https://github.com/ozgemercanoglu/sltbaselines},
  selected={true}
}

@inproceedings{asasi2025beyondgloss,
  google_scholar_id={d1gkVwhDpl0C},
  preview={beyondgloss.png},
  abbr={BMVC},
  bibtex_show={true},
  title={Beyond Gloss: A Hand-Centric Framework for Gloss-Free Sign Language Translation},
  author={Asasi, Sobhan and Lakhal, Mohamed Ilyes and Sincan, Ozge Mercanoglu and Bowden, Richard},
  abstract={BeyondGloss is a gloss-free sign language translation framework that leverages the spatio-temporal reasoning capabilities of Video Large Language Models (VideoLLMs). Since existing VideoLLMs struggle with long videos, we propose a novel approach to generate fine-grained, temporally-aware textual descriptions of hand motion, and introduce a contrastive alignment module that aligns these descriptions with video features during pre-training.},
  booktitle={British Machine Vision Conference (BMVC)},
  address={Sheffield, UK},
  year={2025},
  month={July},
  arxiv={2507.23575},
  code={https://github.com/elsobhano/BeyondGloss},
  html={https://bmva-archive.org.uk/bmvc/2025/assets/papers/Paper_626/paper.pdf},
  selected={true}
}

@inproceedings{asasi2025hierarchical,
  google_scholar_id={u-x6o8ySG0sC},
  preview={hierarchical.png},
  abbr={ACM IVA},
  bibtex_show={true},
  title={Hierarchical Feature Alignment for Gloss-Free Sign Language Translation},
  author={Asasi, Sobhan and Lakhal, Mohamed Ilyes and Bowden, Richard},
  abstract={We propose a novel hierarchical pre-training strategy for sign language translation, inspired by the structure of sign language and incorporating pseudo-glosses and contrastive video-language alignment. The approach operates across frame, segment and video levels, aligning features with pseudo-glosses and target sentences, and yields measured improvements in BLEU-4 and ROUGE.},
  booktitle={ACM International Conference on Intelligent Virtual Agents (IVA), SLTAT Workshop},
  year={2025},
  month={July},
  arxiv={2507.06732},
  selected={true}
}
